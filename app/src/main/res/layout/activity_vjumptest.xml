<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xxbeijing">

    <TextView
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="100dp"
        android:text="@string/cardid"
        android:gravity="center"
        android:textSize="30sp"/>

    <TextView
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginLeft="140dp"
        android:layout_marginTop="100dp"
        android:id="@+id/vjumpcardid"
        android:background="@mipmap/kongbai"
        android:gravity="center"
        android:textSize="40sp"/>

    <TextView
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="200dp"
        android:text="@string/testnum"
        android:gravity="center"
        android:textSize="30sp"/>

    <TextView
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginLeft="140dp"
        android:layout_marginTop="200dp"
        android:id="@+id/vjumptestnum"
        android:background="@mipmap/kongbai"
        android:gravity="center"
        android:textSize="40sp"/>

    <Button
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginLeft="200dp"
        android:layout_marginTop="500dp"
        android:id="@+id/vjumptestconfirm"
        android:gravity="center"
        android:text="@string/confirm"
        android:textSize="30sp"/>

    <Button
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginLeft="450dp"
        android:layout_marginTop="500dp"
        android:id="@+id/vjumptestcomplete"
        android:gravity="center"
        android:text="@string/complete"
        android:textSize="30sp"/>

    <Button
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginLeft="700dp"
        android:layout_marginTop="500dp"
        android:id="@+id/vjumptestcan"
        android:gravity="center"
        android:text="@string/cancel"
        android:textSize="30sp"/>
</RelativeLayout>
