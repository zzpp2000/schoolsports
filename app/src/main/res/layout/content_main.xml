<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xxbeijing">
    <!--android:background="#F5F7FA">-->

    <!-- 服务器网络状态条：默认显示断开 -->
    <LinearLayout
        android:id="@+id/network_status_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="#E53935"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_network_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="服务器已断开连接"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- 顶部看板（边距缩小） -->
    <androidx.cardview.widget.CardView
        android:id="@+id/top_dashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/network_status_bar">
<!--        app:layout_constraintTop_toTopOf="parent">-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- 左侧标题 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏫 体质健康测试系统"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="初三(2)班  ·  今日应测 45 人"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 班级切换 -->
            <TextView
                android:id="@+id/class_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="初三(2)班  ▾"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:background="#EEF2F7"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="12dp"
                android:gravity="center" />

            <!-- 进度条（宽度加长） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="100dp"
                    android:layout_height="8dp"
                    android:progress="80"
                    android:progressTint="#4CAF50"
                    android:background="#E0E0E0" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80%"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 分割线（左右边距缩小） -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/top_dashboard" />

    <!-- 核心功能区：GridLayout 宫格（外边距缩小） -->
    <androidx.gridlayout.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:columnCount="3"
        app:rowCount="5">

        <!-- ====== 第1行：基础类 ====== -->
        <!-- 1. 身高体重 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/HeightWeight_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#D6EAF8"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚖️" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="身高体重" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="基础" android:background="#2980B9" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. 肺活量 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/vitalcapacity_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#D6EAF8"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌬️" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="肺活量" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="基础" android:background="#2980B9" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. 视力 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#D6EAF8"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👁️" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="视力" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="基础" android:background="#2980B9" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- ====== 第2行：速度/爆发 ====== -->
        <!-- 4. 50米跑 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/meter50_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#D5F5E3"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏃" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50米跑" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="速度" android:background="#27AE60" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. 立定跳远 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/standinglongjump_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#D5F5E3"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🦘" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="立定跳远" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="速度" android:background="#27AE60" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 6. 纵跳摸高 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/jump_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#D5F5E3"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📈" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="纵跳" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="速度" android:background="#27AE60" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- ====== 第3行：力量 ====== -->
        <!-- 7. 仰卧起坐 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/situp_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FDEBD0"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💪" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="仰卧起坐" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="力量" android:background="#D35400" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 8. 引体向上 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/pullup_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FDEBD0"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏋️" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="引体向上" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="力量" android:background="#D35400" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 9. 实心球 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/medicineball_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FDEBD0"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚾" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="实心球" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="力量" android:background="#D35400" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- ====== 第4行：柔韧/耐力 ====== -->
        <!-- 10. 坐位体前屈 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/sitandreach_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#EBDEF0"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧘" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="坐位体前屈" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="柔韧" android:background="#8E44AD" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 11. 50米×8 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/meter508_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#EBDEF0"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔄" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50米×8" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="耐力" android:background="#8E44AD" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 12. 长跑 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#EBDEF0"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏅" android:textSize="28sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="长跑" android:textSize="16sp" android:textStyle="bold" android:textColor="#2C3E50" android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="耐力" android:background="#8E44AD" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:layout_gravity="start|top" android:layout_margin="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- ====== 第5行：综合 ====== -->
        <!-- 13. 跳绳 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FADBD8"
            app:cardCornerRadius="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
