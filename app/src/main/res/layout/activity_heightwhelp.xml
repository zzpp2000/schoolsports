<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xxbeijing">

    <Button
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginTop="100dp"
        android:layout_marginLeft="100dp"
        android:id="@+id/Btn_hwvideo"
        android:text="@string/openvideo"/>

    <Button
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginTop="100dp"
        android:layout_marginLeft="300dp"
        android:id="@+id/Btn_hwimport"
        android:text="@string/execlimport"/>

    <Button
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginTop="100dp"
        android:layout_marginLeft="500dp"
        android:id="@+id/Btn_hwexport"
        android:text="@string/execlexport"/>

    <VideoView
        android:id="@+id/hwvideo_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/xxbeijing"/>

</RelativeLayout>
