<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F0">

    <!-- 顶部标题栏（保持不变） -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#3F51B5"
        android:paddingHorizontal="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试数据管理"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_more"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </RelativeLayout>

    <!-- 表格区域（去掉了 HorizontalScrollView，直接使用 LinearLayout） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 表头：宽度设为 match_parent，让 weight 生效 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#E0E0E0"
            android:orientation="horizontal">

            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1" android:text="卡号" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1" android:text="姓名" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:text="测试项目" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1" android:text="数据" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2" android:text="测试时间" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1" android:text="状态" />
        </LinearLayout>

        <!-- 数据列表：宽度设为 match_parent -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"/>
    </LinearLayout>

    <!-- 底部状态栏（保持不变） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">
        <TextView android:id="@+id/tv_device_id" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="设备编号：..." android:textSize="12sp"/>
        <TextView android:id="@+id/tv_storage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="剩余存储空间：..." android:textSize="12sp" android:gravity="center"/>
        <TextView android:id="@+id/tv_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="测试数量：0" android:textSize="12sp" android:gravity="end"/>
    </LinearLayout>
</LinearLayout>